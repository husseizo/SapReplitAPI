{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Filters.Expressions" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Quartz": "Information",
        "SapReplitAPI.Jobs.OrderFullSyncJob": "Debug",
        "SapReplitAPI.Jobs.OrderDeltaSyncJob": "Debug",
        "SapReplitAPI.Controllers.DashboardController": "Debug",
        "SapReplitAPI.Jobs.InvoiceStatusCacheJob": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Debug"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\SAPLogs\\app.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "filter": "StartsWith(SourceContext, 'SapReplitAPI.Jobs.OrderFullSyncJob')",
          "writeTo": [
            {
              "Name": "File",
              "Args": {
                "path": "C:\\SAPLogs\\order-full-sync.log",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 7,
                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "filter": "StartsWith(SourceContext, 'SapReplitAPI.Jobs.OrderDeltaSyncJob')",
          "writeTo": [
            {
              "Name": "File",
              "Args": {
                "path": "C:\\SAPLogs\\order-delta-sync.log",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 7,
                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "filter": "StartsWith(SourceContext, 'SapReplitAPI.Controllers.DashboardController')",
          "writeTo": [
            {
              "Name": "File",
              "Args": {
                "path": "C:\\SAPLogs\\dashboard-controller.log",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 7,
                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "filter": "StartsWith(SourceContext, 'SapReplitAPI.Jobs.InvoiceStatusCacheJob')",
          "writeTo": [
            {
              "Name": "File",
              "Args": {
                "path": "C:\\SAPLogs\\invoice-status-cache.log",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 7,
                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId" ],
    "Properties": {
      "Application": "SAP Replit API"
    }
  },
  "SAP": {
    "Server": "WIN-GJGQ73V0C3K",
    "CompanyDB": "MOLAS_Live_2021",
    "UserName": "hussein",
    "Password": "Modern00.",
